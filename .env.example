# Copy to .env (never commit .env) and export these in your shell before running.

# Laptop (ingest)
ANTHROPIC_API_KEY=            # optional: promise notes and labelling of unmatched subjects
FINN_SERVER_URL=https://your-app.onrender.com
FINN_SYNC_TOKEN=

# Server (Render environment variables)
FINN_SYNC_TOKEN=
FINN_SERVER_DB=data/server.db
VAPID_PUBLIC_KEY=             # push notifications; create with: python -m server.push_keys
VAPID_PRIVATE_B64=
VAPID_SUBJECT=mailto:you@example.com
